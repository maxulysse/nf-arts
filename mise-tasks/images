#!/usr/bin/env bash
#MISE description="Render docs/images from megatest traces and an rnavar test run"
#MISE depends=["install"]
# Render docs/images/megatest-*.png from their nf-core megatest traces, and
# docs/images/test-rnavar-* from the history of a fresh run of the nf-core/rnavar test profile.
set -euo pipefail

BUCKET=s3://nf-core-awsmegatests
ALL='butterfly flowfield ginkgo hilbert hive iris mondrian phyllotaxis radial ridgeline tree'

# render <image prefix> <palette> <source option> <source> <styles>
render() {
    local name=$1 palette=$2 from=$3 source=$4 style size
    for style in $5; do
        case $style in
            flowfield|ginkgo|mondrian|phyllotaxis|ridgeline|tree) size=600 ;;
            *) size=800 ;;
        esac
        # mondrian keeps its own palette
        local options=()
        [ "$style" = mondrian ] || options=(--palette "$palette")
        nextflow plugin nf-arts:render "$from" "$source" --style "$style" "${options[@]}" \
            --width "$size" --height "$size" --file "docs/images/$name-$style.png" </dev/null
    done
}

# megatest <run> <palette> <trace, from the bucket> <styles>
megatest() {
    render "megatest-$1" "$2" --trace "$BUCKET/$3" "$4"
}

megatest rnavar nfcore rnavar/results-ea2c7b6286f5ae18f5b51dc0af6b5330ecd6a13a/pipeline_info/execution_trace_2025-12-05_11-13-40.txt "$ALL"
