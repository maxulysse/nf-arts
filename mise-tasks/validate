#!/usr/bin/env bash
#MISE description="Run the validation pipeline, then check render"
#MISE depends=["install"]
set -euo pipefail

nextflow run validation/
file results/art.png | grep -q 'PNG image data, 1200 x 1200'

# the finished validation run, from the history and cache
nextflow plugin nf-arts:render --file results/rendered.svg
grep -q "$(tail -1 .nextflow/history | cut -f3)</text>" results/rendered.svg
if grep -q 'validation/' results/rendered.svg; then exit 1; fi

# with no --file, both formats
nextflow plugin nf-arts:render
rm art-*.svg art-*.png

# a trace file with its execution report
nextflow plugin nf-arts:render --trace src/test/resources/execution_trace.txt --file results/trace.svg
grep -q 'nf-core/rnavar · 1.2.2 · exotic_kimura' results/trace.svg

# an nf-core megatest on S3, one arc per task
nextflow plugin nf-arts:render --trace s3://nf-core-awsmegatests/rnavar/results-ea2c7b6286f5ae18f5b51dc0af6b5330ecd6a13a/pipeline_info/execution_trace_2025-12-05_11-13-40.txt --file results/megatest.svg
test "$(grep -c '<path ' results/megatest.svg)" -eq 553

# a failed render exits non-zero
if nextflow plugin nf-arts:render no_such_run; then exit 1; fi
